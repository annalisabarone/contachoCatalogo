{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pdipietro/contachoCatalogo/main/schemaCatalogo.json",
  "title": "Catalogo base dei prodotti di ContaCHO",
  "description": "Prodotti di marca con valori verificati sull'etichetta. Nessun dato personale.",
  "type": "object",
  "required": ["formato", "aggiornato", "prodotti"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": 1, "description": "Versione del formato di questo file" },
    "aggiornato": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Data dell'ultima pubblicazione (AAAA-MM-GG)" },
    "fonte": { "type": "string" },
    "prodotti": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "varianti"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,40}$", "description": "Identificativo stabile del prodotto" },
          "nome": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Nome e marca, es. \"Oro Saiwa\"" },
          "codice": { "type": ["string", "null"], "pattern": "^\\d{8,14}$", "description": "Codice a barre GTIN (EAN-8/13, UPC), senza spazi" },
          "pasti": {
            "type": "array",
            "items": { "enum": ["colazione", "pasto", "spuntino"] },
            "uniqueItems": true,
            "description": "Tipo di pasto: colazione, pasto (pranzo o cena), spuntino"
          },
          "varianti": {
            "type": "array",
            "minItems": 1,
            "description": "Valori nel tempo: ogni variante vale dalla sua data in avanti (le etichette cambiano)",
            "items": {
              "type": "object",
              "required": ["dal", "c"],
              "additionalProperties": false,
              "properties": {
                "dal": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Valida da questa data" },
                "c": { "type": "number", "minimum": 0, "maximum": 100, "description": "Carboidrati per 100 g, da etichetta" },
                "pesoPezzo": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000, "description": "Peso di un pezzo in grammi (es. un biscotto), se ha senso" }
              }
            }
          },
          "eliminato": { "type": "boolean", "description": "Prodotto ritirato: resta per i diari già scritti, non si propone più" }
        }
      }
    }
  }
}
